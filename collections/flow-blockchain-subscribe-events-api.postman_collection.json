          "id": "e5f7fe50-e007-47aa-90db-a43881ce317c",
          "name": "Subscribe events",
          "request": {
            "name": "Subscribe events",
            "description": {
              "content": "IMPORTANT NOTE: This is a WebSocket connection, so the `ws://` or `wss://` schema should be used to subscribe to this endpoint.\n\nThis endpoint streams on-chain events for all blocks starting at the requested start block, up until the latest available block. Once the latest block is reached, the stream will remain open, and responses will be sent for each new block as it becomes available.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "subscribe_events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_height",
                  "value": "<uint64>",
                  "description": "The block height of the events being streamed. Either provide this parameter or `start_block_id` parameter. This parameter is incompatible with `start_block_id` parameter."
                },
                {
                  "disabled": false,
                  "key": "start_block_id",
                  "value": "<hexadecimal>",
                  "description": "The block id of the events being streamed. Either provide this parameter or `start_height` parameter. This parameter is incompatible with `start_height` parameter."
                },
                {
                  "disabled": false,
                  "key": "heartbeat_interval",
                  "value": "<uint64>",
                  "description": "Interval in block heights at which the server should return a heartbeat message to the client."
                },
                {
                  "disabled": false,
                  "key": "event_types",
                  "value": "<string>",
                  "description": "A comma-separated list of events type to include."
                },
                {
                  "disabled": false,
                  "key": "addresses",
                  "value": "<string>",
                  "description": "A comma-separated list of addresses who's events should be included."
                },
                {
                  "disabled": false,
                  "key": "contracts",
                  "value": "<string>",
                  "description": "A comma-separated list of contracts who's events should be included."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
