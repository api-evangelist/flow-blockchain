    },
    "status": {
      "@id": "flow:status",
      "@type": "xsd:string"
    },
    "status_code": {
      "@id": "flow:statusCode",
      "@type": "xsd:integer"
    },
    "error_message": {
      "@id": "flow:errorMessage",
      "@type": "xsd:string"
    },
    "computation_used": {
      "@id": "flow:computationUsed",
      "@type": "xsd:string"
    },
    "execution": {
      "@id": "flow:execution",
      "@type": "xsd:string"
    },
    "events": {
      "@id": "flow:events",
      "@container": "@list"
    },
    "chunks": {
      "@id": "flow:chunks",
      "@container": "@list"
    },
