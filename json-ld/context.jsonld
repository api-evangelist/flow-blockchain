      "@id": "flow:transactionIndex",
      "@type": "xsd:string"
    },
    "event_index": {
      "@id": "flow:eventIndex",
      "@type": "xsd:string"
    },
    "payload": {
      "@id": "flow:payload",
      "@type": "xsd:string"
    },
    "script": {
      "@id": "flow:script",
      "@type": "xsd:string"
    },
    "arguments": {
      "@id": "flow:arguments",
      "@container": "@list"
    },
    "reference_block_id": {
      "@id": "flow:referenceBlockId",
      "@type": "xsd:string"
    },
    "gas_limit": {
      "@id": "flow:gasLimit",
      "@type": "xsd:string"
    },
    "payer": {
      "@id": "flow:payer",
      "@type": "xsd:string"
    },
    "proposal_key": {
      "@id": "flow:proposalKey"
    },
    "authorizers": {
      "@id": "flow:authorizers",
      "@container": "@list"
    },
    "payload_signatures": {
      "@id": "flow:payloadSignatures",
