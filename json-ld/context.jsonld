      "@type": "xsd:string"
    },
    "spork_id": {
      "@id": "flow:sporkId",
      "@type": "xsd:string"
    },
    "protocol_version": {
      "@id": "flow:protocolVersion",
      "@type": "xsd:string"
    },
    "protocol_state_version": {
      "@id": "flow:protocolStateVersion",
      "@type": "xsd:string"
    },
    "spork_root_block_height": {
      "@id": "flow:sporkRootBlockHeight",
      "@type": "xsd:string"
    },
    "node_root_block_height": {
      "@id": "flow:nodeRootBlockHeight",
      "@type": "xsd:string"
    },
    "compatible_range": {
      "@id": "flow:compatibleRange"
    },
    "start_height": {
      "@id": "flow:startHeight",
      "@type": "xsd:string"
    },
    "end_height": {
      "@id": "flow:endHeight",
      "@type": "xsd:string"
    },
    "header": {
      "@id": "flow:header"
    },
    "payload_field": {
      "@id": "flow:blockPayload"
